# AppleBridge Mac Daemon Makefile - 68k Version
# For use with MPW on Basilisk II (68k emulation)
# Use this instead of the PowerPC Makefile

# Compiler and tools (68k versions)
CC = SC
LINK = Link

# You must set LIBS before running make:
# Set LIBS 'MeinMac:Interfaces&Libraries:Libraries:'

# Directories
SRC_DIR = :src:
INC_DIR = :include:
OBJ_DIR = :obj:
BIN_DIR = :bin:

# Compiler flags. -model far is REQUIRED (not just at link): the combined CODE
# grew past the 68K near-model 32 KB PC-relative limit (Link "Error 48: PC-relative
# edit, offset out of range"), so inter-module calls must use 32-bit (far) refs.
CFLAGS = -i {INC_DIR} -model far

# Linker flags - IMPORTANT: -model far (must match the compile model above)!
LDFLAGS = -model far -o {BIN_DIR}AppleBridge

# Libraries - use {LIBS} variable set in shell
LIBS_LIST = "{LIBS}CLibraries:StdCLib.o" "{LIBS}Libraries:OpenTransport.o" "{LIBS}Libraries:OpenTransportApp.o" "{LIBS}Libraries:OpenTptInet.o" "{LIBS}Libraries:Interface.o" "{LIBS}Libraries:MacRuntime.o"

# Object files
# The transport seam: transport.c (dispatcher) + transport_ot.c (Open Transport
# backend, was network.c) + transport_mactcp.c (MacTCP backend). MacTCP needs no
# extra library — its driver calls (PBControl/OpenDriver) resolve via Interface.o.
OBJS = {OBJ_DIR}main.c.o {OBJ_DIR}transport.c.o {OBJ_DIR}transport_ot.c.o {OBJ_DIR}transport_mactcp.c.o {OBJ_DIR}transport_serial.c.o {OBJ_DIR}protocol.c.o {OBJ_DIR}command.c.o {OBJ_DIR}screenshot.c.o {OBJ_DIR}fileio.c.o {OBJ_DIR}events.c.o {OBJ_DIR}utils.c.o {OBJ_DIR}mystring.c.o {OBJ_DIR}prefs.c.o {OBJ_DIR}auth.c.o {OBJ_DIR}nbp.c.o

# Default target
all ƒ {BIN_DIR}AppleBridge

# Link + merge the SIZE resource (onlyBackground / isHighLevelEventAware) and set
# the real creator. The Rez step used to be out-of-band — it is now part of the
# build so a fresh :bin:AppleBridge can never be missing its SIZE resource.
{BIN_DIR}AppleBridge ƒ {OBJS} AppleBridge_res.r
	{LINK} {LDFLAGS} {OBJS} {LIBS_LIST}
	Rez AppleBridge_res.r -a -o {BIN_DIR}AppleBridge
	Rez vers.r -a -o {BIN_DIR}AppleBridge
	SetFile -t APPL -c 'ABrg' {BIN_DIR}AppleBridge

# Compile rules
{OBJ_DIR}main.c.o ƒ {SRC_DIR}main.c {INC_DIR}applebridge.h {INC_DIR}mystring.h
	{CC} {CFLAGS} {SRC_DIR}main.c -o {OBJ_DIR}main.c.o

{OBJ_DIR}transport.c.o ƒ {SRC_DIR}transport.c {INC_DIR}transport.h {INC_DIR}transport_priv.h
	{CC} {CFLAGS} {SRC_DIR}transport.c -o {OBJ_DIR}transport.c.o

{OBJ_DIR}transport_ot.c.o ƒ {SRC_DIR}transport_ot.c {INC_DIR}transport.h {INC_DIR}transport_priv.h {INC_DIR}applebridge.h
	{CC} {CFLAGS} {SRC_DIR}transport_ot.c -o {OBJ_DIR}transport_ot.c.o

{OBJ_DIR}transport_mactcp.c.o ƒ {SRC_DIR}transport_mactcp.c {INC_DIR}transport.h {INC_DIR}transport_priv.h {INC_DIR}applebridge.h
	{CC} {CFLAGS} {SRC_DIR}transport_mactcp.c -o {OBJ_DIR}transport_mactcp.c.o

{OBJ_DIR}transport_serial.c.o ƒ {SRC_DIR}transport_serial.c {INC_DIR}transport.h {INC_DIR}transport_priv.h
	{CC} {CFLAGS} {SRC_DIR}transport_serial.c -o {OBJ_DIR}transport_serial.c.o

{OBJ_DIR}protocol.c.o ƒ {SRC_DIR}protocol.c {INC_DIR}applebridge.h {INC_DIR}mystring.h
	{CC} {CFLAGS} {SRC_DIR}protocol.c -o {OBJ_DIR}protocol.c.o

{OBJ_DIR}command.c.o ƒ {SRC_DIR}command.c {INC_DIR}applebridge.h {INC_DIR}mystring.h
	{CC} {CFLAGS} {SRC_DIR}command.c -o {OBJ_DIR}command.c.o

{OBJ_DIR}screenshot.c.o ƒ {SRC_DIR}screenshot.c {INC_DIR}applebridge.h
	{CC} {CFLAGS} {SRC_DIR}screenshot.c -o {OBJ_DIR}screenshot.c.o

{OBJ_DIR}fileio.c.o ƒ {SRC_DIR}fileio.c {INC_DIR}applebridge.h
	{CC} {CFLAGS} {SRC_DIR}fileio.c -o {OBJ_DIR}fileio.c.o

{OBJ_DIR}events.c.o ƒ {SRC_DIR}events.c {INC_DIR}applebridge.h
	{CC} {CFLAGS} {SRC_DIR}events.c -o {OBJ_DIR}events.c.o

{OBJ_DIR}utils.c.o ƒ {SRC_DIR}utils.c {INC_DIR}applebridge.h
	{CC} {CFLAGS} {SRC_DIR}utils.c -o {OBJ_DIR}utils.c.o

{OBJ_DIR}mystring.c.o ƒ {SRC_DIR}mystring.c {INC_DIR}mystring.h
	{CC} {CFLAGS} {SRC_DIR}mystring.c -o {OBJ_DIR}mystring.c.o

{OBJ_DIR}prefs.c.o ƒ {SRC_DIR}prefs.c {INC_DIR}prefs.h {INC_DIR}mystring.h
	{CC} {CFLAGS} {SRC_DIR}prefs.c -o {OBJ_DIR}prefs.c.o

{OBJ_DIR}auth.c.o ƒ {SRC_DIR}auth.c {INC_DIR}auth.h
	{CC} {CFLAGS} {SRC_DIR}auth.c -o {OBJ_DIR}auth.c.o

{OBJ_DIR}nbp.c.o ƒ {SRC_DIR}nbp.c {INC_DIR}applebridge.h
	{CC} {CFLAGS} {SRC_DIR}nbp.c -o {OBJ_DIR}nbp.c.o

# Clean target
clean ƒ
	Delete -i {OBJ_DIR}main.c.o {OBJ_DIR}transport.c.o {OBJ_DIR}transport_ot.c.o {OBJ_DIR}transport_mactcp.c.o {OBJ_DIR}transport_serial.c.o {OBJ_DIR}protocol.c.o {OBJ_DIR}command.c.o {OBJ_DIR}screenshot.c.o {OBJ_DIR}fileio.c.o {OBJ_DIR}utils.c.o {OBJ_DIR}mystring.c.o {OBJ_DIR}prefs.c.o {OBJ_DIR}auth.c.o {OBJ_DIR}nbp.c.o || Set Status 0
	Delete -i {BIN_DIR}AppleBridge || Set Status 0

# Create directories
dirs ƒ
	NewFolder {OBJ_DIR}
	NewFolder {BIN_DIR}
