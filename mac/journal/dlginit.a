*-------------------------------------------------------------------------------------------
* dlginit.a -- boot INIT: install the dlgpatch _ModalDialog head patch GLOBALLY.
* Pure-asm INIT (type INIT/creator ABdp), sysheap+locked. At boot: NewPtrSys +
* BlockMove the embedded DPAT into the system heap, chain the real _ModalDialog
* into +6, NSetTrapAddress. Bails harmlessly (RTS, trap unchanged) on any failure.
* Embeds DPAT 128 byte-exact (READFILE + resource-fork parse, 1820 B) -- the fork is
* not current at INIT time, so it cannot Get1Resource; mirrors msinit.a. The block
* ships DISARMED (Armed word 0): a transparent JMP until the daemon arms it.
* Layout: +4 Magic $4450, +6 Real, +10 Armed, +12 OneShot, +14 DialogUp, +16 Gen.
*-------------------------------------------------------------------------------------------

        CASE    OBJ
        STRING  ASIS

tNewPtrSys      EQU     $A51E
tBlockMove      EQU     $A02E
tGetToolTrap    EQU     $A746
tSetToolTrap    EQU     $A647
trModalDialog   EQU     $A991
kMagic          EQU     $4450
kPatchLen       EQU     1820

DlgInit         PROC    EXPORT
        MOVEM.L D0-D2/A0-A2,-(SP)
        MOVE.L  #kPatchLen,D0
        DC.W    tNewPtrSys
        MOVE.L  A0,A2
        MOVE.L  A0,D0
        BEQ.S   Bail
        LEA     PatchData(PC),A0
        MOVE.L  A2,A1
        MOVE.L  #kPatchLen,D0
        DC.W    tBlockMove
        CMP.W   #kMagic,4(A2)
        BNE.S   Bail
        MOVE.W  #trModalDialog,D0
        DC.W    tGetToolTrap
        MOVE.L  A0,6(A2)
        MOVE.L  A2,A0
        MOVE.W  #trModalDialog,D0
        DC.W    tSetToolTrap
Bail
        MOVEM.L (SP)+,D0-D2/A0-A2
        RTS

* ---- embedded 'DPAT' 128 (dlgpatch), byte-exact, 1820 bytes ----
