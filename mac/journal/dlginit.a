*-------------------------------------------------------------------------------------------
*
* NAME
*       dlginit.a -- boot INIT: install the _ModalDialog head patch (dlgpatch) GLOBALLY.
*
* DESCRIPTION
*       System 7 extension ('INIT' id 0, sysheap+locked). At startup the System
*       calls it; it copies the dlgpatch code resource into the SYSTEM heap and
*       points the _ModalDialog ($A991) tool trap at it. Installed at boot from an
*       extension, the patch lives in the system heap and applies to EVERY app --
*       the global reach the cross-app dialog walk needs (a running app's
*       DLGINSTALL is process-local; proven 2026-08-02 via DLGSELFMODAL: the same
*       code FIRES + walks in-process, generation 0->2, so cross-app generation:0
*       was reach, not a firing bug).
*
*       SELF-CONTAINED like msinit.a: the patch bytes are embedded here (PatchData),
*       byte-exact from the built DPAT 128 (READFILE + resource-fork parse, 1780 B),
*       and copied from THIS resource -- NO Get1Resource of a sibling 'DPAT' at boot
*       (that depends on the extension's fork being current, which it is not during
*       INIT execution). The dlgpatch code is A5-free + PC-relative (self-sufficient
*       since the CountDITL fix), so it self-relocates after the BlockMove.
*
*       Position-independent, no A5. Preserves D0-D2/A0-A2. Bails harmlessly (RTS,
*       trap unchanged) on ANY failure -- a boot INIT must never wedge boot.
*
*       Patch block layout: dlgpatch.a (+4 Magic $4450 'DP', +6 Real).
*-------------------------------------------------------------------------------------------

        CASE    OBJ
        STRING  ASIS

tNewPtrSys      EQU     $A51E           ; NewPtr + SYS  (OS: D0=size -> A0=ptr)
tBlockMove      EQU     $A02E           ; BlockMove     (OS: A0=src,A1=dst,D0=n)
tGetToolTrap    EQU     $A746           ; GetToolTrapAddress (D0=trap -> A0=addr)
tSetToolTrap    EQU     $A647           ; SetToolTrapAddress (A0=addr, D0=trap)
trModalDialog   EQU     $A991
kMagic          EQU     $4450           ; dlgpatch 'DP' magic (at block +4)
kPatchLen       EQU     1780            ; DPAT 128 = 890 words (keep in sync)

DlgInit         PROC    EXPORT
        MOVEM.L D0-D2/A0-A2,-(SP)

        ; blk = NewPtrSys(kPatchLen)
        MOVE.L  #kPatchLen,D0
        DC.W    tNewPtrSys
        MOVE.L  A0,A2                    ; A2 = blk
        MOVE.L  A0,D0
        BEQ.S   Bail

        ; BlockMove(PatchData, blk, kPatchLen)
        LEA     PatchData(PC),A0         ; src (this resource, PC-relative)
        MOVE.L  A2,A1                    ; dst = blk
        MOVE.L  #kPatchLen,D0
        DC.W    tBlockMove

        ; verify copied magic (at +4) before touching the trap
        CMP.W   #kMagic,4(A2)
        BNE.S   Bail

        ; real = GetToolTrapAddress(ModalDialog); stash in blk+6
        MOVE.W  #trModalDialog,D0
        DC.W    tGetToolTrap
        MOVE.L  A0,6(A2)

        ; SetToolTrapAddress(blk, ModalDialog) -- go live (global)
        MOVE.L  A2,A0
        MOVE.W  #trModalDialog,D0
        DC.W    tSetToolTrap
Bail
        MOVEM.L (SP)+,D0-D2/A0-A2
        RTS

* ---- embedded 'DPAT' 128 (dlgpatch), byte-exact, 1780 bytes ----
